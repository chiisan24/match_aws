# ----------------------------------------------------------------------------
# AI backend configuration
#
# The AI features (チャット / プラン生成 / 翻訳 / 画像生成) run for real through
# the serverless functions under `api/`, which call Amazon Bedrock & Amazon
# Translate SERVER-SIDE. The browser never holds AWS credentials.
#
# - Leave VITE_AWS_API_ENDPOINT UNSET  -> the app runs entirely on mocks
#   (no AWS needed; safe default for demos / local dev / Vercel without AWS).
# - Set VITE_AWS_API_ENDPOINT=/api     -> the app calls the real AI backend.
#
# Only VITE_-prefixed variables are exposed to the client bundle by Vite.
# The AWS_* / BEDROCK_* variables below are SERVER-ONLY (no VITE_ prefix) and
# must be set in the Vercel project's Environment Variables (or .env.local).
# Copy this file to `.env.local` for local development. NEVER commit real values.
# ----------------------------------------------------------------------------

# ---- Client (browser) ------------------------------------------------------
# Base URL of the serverless API. Use "/api" for same-origin Vercel Functions.
VITE_AWS_API_ENDPOINT=

# Set to "true" to force mock adapters even if the endpoint is set (demos).
VITE_FORCE_MOCK=

# Local development only: show the global debug shortcuts and enable defaults.
# This flag is ignored by production builds even when set to "true".
VITE_DEBUG_MODE=

# Debug-only "skip swiping" shortcuts (route builder deck + swipe tab).
# Defaults to VITE_DEBUG_MODE; set to "false" to hide the shortcuts while
# keeping debug mode on. Always off in production builds.
VITE_DEBUG_SKIP_SWIPE=

# ---- Map -------------------------------------------------------------------
# Google Maps JavaScript API browser key. This value is visible in the browser,
# so use a SEPARATE key restricted by HTTP referrer and to Maps JavaScript API.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
# Optional Google Cloud map ID. Leave blank to use DEMO_MAP_ID for local checks.
VITE_GOOGLE_MAPS_MAP_ID=

# Existing MapLibre fallback used when the Google key/SDK is unavailable.
# Set to "true" to allow the fallback real map instead of the mock surface.
VITE_MAP_ENABLED=
# Optional: override the built-in OpenStreetMap raster style with a MapLibre
# style URL (public URL / public-scoped key only). Leave blank to use OSM.
VITE_MAP_STYLE_URL=

# ---- Server (Vercel Functions only — do NOT prefix with VITE_) -------------
# Google Places API (New) key used to verify AI recommendations and retrieve
# place photos. Keep this server-only; enable Places API (New) for the key.
GOOGLE_MAPS_API_KEY=

# Region used by Bedrock, Translate, and DynamoDB.
AWS_REGION=ap-northeast-1

# Bedrock API key (Bearer token). This only authenticates Bedrock/Bedrock Runtime;
# never expose it through a VITE_-prefixed variable.
AWS_BEARER_TOKEN_BEDROCK=

# Claude Sonnet 4.6 inference profile used by chat and plan generation.
BEDROCK_MODEL_ID=jp.anthropic.claude-sonnet-4-6

# Optional: image model used by Bedrock Runtime.
BEDROCK_IMAGE_MODEL_ID=amazon.titan-image-generator-v1

# Optional IAM credentials. Required for non-Bedrock services used by this app
# (Amazon Translate and DynamoDB); not required for Bedrock when the API key
# above is set. AWS_SESSION_TOKEN may also be set for temporary credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- Spot catalogue API (DynamoDB) — runtime spot additions ----------------
# When VITE_AWS_API_ENDPOINT is set, the app reads/writes runtime-added spots
# through GET/POST /api/spots (backed by DynamoDB). The ~400 seed spots stay
# bundled in the client, so DynamoDB only stores the additions.
#
# Client: the admin token sent with POST /api/spots (must equal the server-side
# SPOTS_ADMIN_TOKEN below). Leave blank to keep the catalogue read-only.
VITE_SPOT_ADMIN_TOKEN=
# Server (Vercel Functions only): DynamoDB table name (default "match-spots")
# and the shared admin token that authorises writes. If SPOTS_ADMIN_TOKEN is
# unset, POST /api/spots refuses all writes (read-only).
SPOTS_TABLE=match-spots
SPOTS_ADMIN_TOKEN=

# ---- Reserved for future AWS adapters (map/auth/storage — still mocked) -----
VITE_AWS_IDENTITY_POOL_ID=
VITE_AWS_LOCATION_MAP_NAME=
VITE_AWS_LOCATION_PLACE_INDEX=
